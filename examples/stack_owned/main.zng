// References without lifetimes are fine for these member functions' arguments: nothing returned
// borrows from them.
#allow(elided_lifetimes)

#cpp_additional_includes "
#include <cpp_type.h>
"

type c++::MyCppWrapper {
    #trivially_relocatable;
    #layout(size = 8, align = 4);

    // C++ member functions, which Rust calls as methods. `&const self` is a `const` member function,
    // which `const` objects (`MyCppWrapper<Const>`) have too, and `&unique var self` a non-`const`
    // one (`&mut self` in Rust). A C++ `const T&` is a `&'a const T` in the `.zng` file
    // (`&'a T<Const>` in Rust, or `&'a Cpp<i32, Const>` for a builtin).
    safe fn sum(&const self) -> i32;
    safe fn scale(&unique var self, i32);
    safe fn add(&unique var self, &const c++::MyCppWrapper);
    safe fn x_ref<'a>(&'a const self) -> &'a const i32;
    safe fn swapped(&const self) -> c++::MyCppWrapper;
    safe static fn diagonal(i32) -> c++::MyCppWrapper;

    // C++ constructors, which `zngur_lib::ZngCppConstruct` runs in place. C++-style pointers and
    // references (`const T*`, `T&`, ...) are raw pointers in Rust.
    safe constructor(i32, i32);
    safe constructor(&const c++::MyCppWrapper);
    unsafe constructor(const c++::MyCppWrapper*, i32);

    // Accessors for C++ fields, which return a reference to the field (`&Cpp<i32, Const>`,
    // `&mut Cpp<i32>`).
    field &const x (type = i32);
    field &unique var x (type = i32) as x_mut;
    field &const y (type = i32);
}

type c++::MyConservativeWrapper {
    #trivially_relocatable;
    #layout_conservative(size = 32, align = 16);

    safe fn total_with(&const self, c++::MyConservativeWrapper) -> i64;
    safe constructor(i64, i32);
}

// Free C++ functions, in their C++ namespace. Rust calls them directly, as
// `generated::geometry::dot(...)`; `as` names C++ overloads.
mod c++::geometry {
    safe fn dot(&const c++::MyCppWrapper, &const c++::MyCppWrapper) -> i32;
    safe fn origin() -> c++::MyCppWrapper;
    safe fn twice(i64) -> i64;
    safe fn twice(f64) -> f64 as twice_f64;
}

// Instantiations of C++ class templates. Each C++ template is one generic Rust struct:
// `generated::Pair<i32>`, `generated::std::unique_ptr<generated::Pair<i32>>`.
type c++::Pair<i32> {
    #layout(size = 8, align = 4);
    #trivially_relocatable;

    safe constructor(i32, i32);
    safe fn sum(&const self) -> i32;
    field &unique var first (type = i32) as first_mut;
}

type c++::Pair<f64> {
    #layout(size = 16, align = 8);
    #trivially_relocatable;

    safe constructor(f64, f64);
    safe fn sum(&const self) -> f64;
}

type c++::std::unique_ptr<c++::Pair<i32>> {
    #layout(size = 8, align = 8);
    #trivially_relocatable;

    safe fn get(&const self) -> c++::Pair<i32>*;
}

mod c++::pairs {
    safe fn boxed(i32, i32) -> c++::std::unique_ptr<c++::Pair<i32>>;
}

// Fields can be `const` (and then only have `const` accessors), be named like a zngur keyword,
// and be C++ pointers (`&Cpp<*mut Node, Const>`, `&mut Cpp<*mut Node>`).
type c++::Node {
    #layout(size = 16, align = 8);
    #trivially_relocatable;

    safe constructor(i32);
    field &const id (type = i32);
    field &unique var type (type = i32) as type_mut;
    field &const next (type = c++::Node*);
    field &unique var next (type = c++::Node*) as next_mut;
}

// `const` is part of the type: a C++ template can be instantiated with a `const` type
// (`View<Cpp<i32, Const>>` in Rust).
type c++::View<const i32> {
    #layout(size = 16, align = 8);
    #trivially_relocatable;

    safe fn size(&const self) -> usize;
    // Out-of-bounds indices are UB, so this is `unsafe`.
    unsafe fn at<'a>(&'a const self, usize) -> &'a const i32;
}

mod c++::views {
    safe fn squares() -> c++::View<const i32>;
}

extern "C++" {
    impl c++::MyCppWrapper {
        safe fn new(i32, i32) -> c++::MyCppWrapper;
        safe fn print(&self);
    }

    impl c++::MyConservativeWrapper {
        safe fn new(i64, i32) -> c++::MyConservativeWrapper;
        safe fn print(&self);
    }

    // C++-style pointers and references are raw pointers in Rust (`*const T<Const>` for
    // `const T&`, `*mut T` for `T*`, `*mut Cpp<i32>` for `i32*`), and plain pointers in C++.
    unsafe fn sum_into(const c++::MyCppWrapper&, i32*);
    unsafe fn swap_xy(c++::MyCppWrapper*);
    unsafe fn larger_x(const c++::MyCppWrapper&, const c++::MyCppWrapper&) -> const c++::MyCppWrapper*;
}
