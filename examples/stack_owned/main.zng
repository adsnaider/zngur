#cpp_additional_includes "
#include <cpp_type.h>
"

type c++::MyCppWrapper {
    #cpp_stack_owned "::CppType";
    #layout(size = 8, align = 4);

    // C++ member functions, which Rust calls directly. They take `this` as a
    // `zngur_lib::CppPtr`, so they must be `unsafe` (static ones may be `safe`).
    unsafe fn sum() const -> i32;
    unsafe fn scale(i32);
    unsafe fn add(const c++::MyCppWrapper&);
    unsafe fn x_ref() const -> const i32&;
    unsafe fn swapped() const -> c++::MyCppWrapper;
    safe static fn diagonal(i32) -> c++::MyCppWrapper;
}

type crate::MyConservativeWrapper {
    #cpp_stack_owned "::CppConservativeType";
    #layout_conservative(size = 32, align = 16);

    unsafe fn total_with(crate::MyConservativeWrapper) const -> i64;
}

extern "C++" {
    impl c++::MyCppWrapper {
        safe fn new(i32, i32) -> c++::MyCppWrapper;
        safe fn print(&self);
    }

    impl crate::MyConservativeWrapper {
        safe fn new(i64, i32) -> crate::MyConservativeWrapper;
        safe fn print(&self);
    }

    // C++ pointers and references are `zngur_lib::CppPtr`s in Rust, and plain pointers in C++.
    unsafe fn sum_into(const c++::MyCppWrapper&, i32*);
    unsafe fn swap_xy(c++::MyCppWrapper*);
    unsafe fn larger_x(const c++::MyCppWrapper&, const c++::MyCppWrapper&) -> const c++::MyCppWrapper*;
}
