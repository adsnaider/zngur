// References without lifetimes are fine for these member functions' arguments: nothing returned
// borrows from them.
#allow(elided_lifetimes)

#cpp_additional_includes "
#include <cpp_type.h>
"

type crate::RustTag {
    #layout(size = 4, align = 4);
    wellknown_traits(Copy);
    fn bonus(&self) -> i32;
}

type c++::MyCppWrapper {
    #trivially_relocatable;
    #layout(size = 8, align = 4);

    // C++ member functions, which Rust calls as methods. `&const self` is a `const` member function,
    // which `const` objects (`MyCppWrapper<Const>`) have too, and `&unique var self` a non-`const`
    // one (`&mut self` in Rust). A C++ `const T&` is a `&'a const T` in the `.zng` file
    // (`&'a T<Const>` in Rust, or `&'a Cpp<i32, Const>` for a builtin). Arguments that are `const`
    // objects are generic over their constness (`&'a T<C1>`), so they take non-`const` ones too.
    safe fn sum(&const self) -> i32;
    safe fn scale(&unique var self, i32);
    safe fn add(&unique var self, &const c++::MyCppWrapper);
    safe fn x_ref<'a>(&'a const self) -> &'a const i32;
    safe fn x_ref<'a>(&'a unique var self) -> &'a unique var i32 as x_ref_mut;
    safe fn bump_x(&var self, i32);
    unsafe fn sum(const self*) -> i32 as raw_sum;
    safe fn is_positive(&const self, bool) -> bool;
    safe fn with_rust_tag(&const self, &crate::RustTag) -> i32;
    safe fn swapped(&const self) -> c++::MyCppWrapper;
    safe fn diagonal(i32) -> c++::MyCppWrapper;

    // C++ constructors, which are Rust functions named with `as` (not `new` here, which the
    // `extern "C++"` block below takes). They return a `zngur_lib::CppCtor`, which runs the
    // constructor in place. C++-style pointers and references (`const T*`, `T&`, ...) are raw
    // pointers in Rust.
    safe constructor(i32, i32) as from_xy;
    safe constructor(&const c++::MyCppWrapper) as copy;
    unsafe constructor(const c++::MyCppWrapper*, i32) as shifted;

    // Accessors for C++ fields, which return a reference to the field (`&Cpp<i32, Const>`,
    // `&mut Cpp<i32>`).
    field &const x (type = i32);
    field &unique var x (type = i32) as x_mut;
    field &const y (type = i32);
}

type c++::MyConservativeWrapper {
    #trivially_relocatable;
    #layout_conservative(size = 20, align = 8);

    safe fn total_with(&const self, c++::MyConservativeWrapper) -> i64;
    safe constructor(i64, i32) as from_values;
}

// Free C++ functions, in their C++ namespace. Rust calls them directly, as
// `generated::geometry::dot(...)`; `as` names C++ overloads.
mod c++::geometry {
    type Tag {}
    safe fn read_tag(&const Tag) -> i32 as Tag;
    safe fn dot(&const c++::MyCppWrapper, &const c++::MyCppWrapper) -> i32;
    safe fn origin() -> c++::MyCppWrapper;
    safe fn pick_first<'a>(
        &'a const c++::MyCppWrapper,
        &const c++::MyCppWrapper,
    ) -> &'a const c++::MyCppWrapper;
    unsafe fn sum_from_ptr(const c++::MyCppWrapper*) -> i32;
    safe fn twice(i64) -> i64;
    safe fn twice(f64) -> f64 as twice_f64;
}

// Instantiations of C++ class templates. Each C++ template is one generic Rust type alias:
// `generated::Pair<i32>`, `generated::std::unique_ptr<generated::Pair<i32>>`.
type c++::Pair<i32> {
    #layout(size = 8, align = 4);
    #trivially_relocatable;

    safe constructor(i32, i32) as new;
    safe fn sum(&const self) -> i32;
    field &unique var first (type = i32) as first_mut;
}

type c++::Pair<f64> {
    #layout(size = 16, align = 8);
    #trivially_relocatable;

    safe constructor(f64, f64) as new;
    safe fn sum(&const self) -> f64;
}

type c++::std::unique_ptr<c++::Pair<i32>> {
    #layout(size = 8, align = 8);
    #trivially_relocatable;

    // The owned object, if any (a C++ pointer, null if the `unique_ptr` is empty), borrowed from
    // the `unique_ptr`.
    safe fn get<'a>(&'a const self) -> ::std::option::Option<&'a var c++::Pair<i32>>;
    safe fn get<'a>(&'a unique var self) -> ::std::option::Option<&'a unique var c++::Pair<i32>> as get_mut;
}

mod c++::pairs {
    safe fn boxed(i32, i32) -> c++::std::unique_ptr<c++::Pair<i32>>;
}

type<T> c++::View<T> {
    #layout(size = 16, align = 8);
    #trivially_relocatable;

    safe fn size(&const self) -> usize;
    // Out-of-bounds indices are UB, so this is `unsafe`.
    unsafe fn at<'a>(&'a const self, usize) -> &'a var T;
    field &const len (type = usize);
}

// A template instantiation with a pointer argument declared before the pointee type (`c++::Node`).
type c++::View<const c++::Node*> {}

// Fields can be `const` (and then only have `const` accessors), be named like a zngur keyword,
// and be C++ pointers (`&Cpp<*mut Node, Const>`, `&mut Cpp<*mut Node>`).
type c++::Node {
    #layout(size = 16, align = 8);
    #trivially_relocatable;

    safe constructor(i32) as new;
    field &const id (type = i32);
    field &unique var type (type = i32) as type_mut;
    field &const next (type = c++::Node*);
    unsafe field &unique var next (type = c++::Node*) as next_mut;
}

// `const` is part of the type: a C++ template can be instantiated with a `const` type
// (`View<Cpp<i32, Const>>` in Rust).
type c++::View<const i32> {}

mod c++::views {
    safe fn squares() -> c++::View<const i32>;
    unsafe fn pair_nodes(const c++::Node*) -> c++::View<const c++::Node*>;
}

type c++::BoxedInt {
    #trivially_relocatable;
    #layout_conservative(size = 16, align = 8);
}

type c++::OpaqueRef {
    #layout_conservative(size = 16, align = 8);
}

type Box<dyn for<'a> Fn(&'a const c++::MyCppWrapper, &'a unique var bool) -> &'a const c++::MyCppWrapper> {
    #layout(size = 16, align = 8);
}

type<'a> crate::RustBorrow<'a> {
    #layout(size = 16, align = 8);
    constructor(&'a const c++::MyCppWrapper, &'a unique var i32);
    fn record_sum(&mut self) -> i32;
}

type crate::RustCounter {
    #layout(size = 4, align = 4);
    constructor(i32);
    fn add_cpp(&self, &const c++::MyCppWrapper) -> i32;
    fn add_cpp_mut(&mut self, &const c++::MyCppWrapper, &unique var i32);
}

type crate::RustHolder {
    #layout(size = 4, align = 4);
    constructor { counter: crate::RustCounter };
    field counter (offset = 0, type = crate::RustCounter);
    fn borrow_counter<'a>(&'a self) -> &'a crate::RustCounter;
    fn borrow_counter_mut<'a>(&'a mut self) -> &'a mut crate::RustCounter;
}

trait crate::CppSelector {
    fn select<'a>(
        &self,
        &'a const c++::MyCppWrapper,
        &'a const c++::MyCppWrapper,
    ) -> &'a const c++::MyCppWrapper;
}

type Box<dyn crate::CppSelector> {
    #layout(size = 16, align = 8);
}

mod crate {
    fn invoke_cpp_selector<'a>(
        Box<dyn crate::CppSelector>,
        &'a const c++::MyCppWrapper,
        &'a const c++::MyCppWrapper,
    ) -> &'a const c++::MyCppWrapper;
    fn read_opaque(&const c++::OpaqueRef) -> i32;
    fn inspect_mut_opaque(&unique var c++::OpaqueRef) -> i32;
    fn flip_and_pick<'a>(
        &'a const c++::MyCppWrapper,
        &'a const c++::MyCppWrapper,
        &'a unique var bool,
    ) -> &'a const c++::MyCppWrapper;
    fn invoke_cpp_callback(
        Box<dyn for<'a> Fn(&'a const c++::MyCppWrapper, &'a unique var bool) -> &'a const c++::MyCppWrapper>,
    ) -> i32;
    fn scale_if_some<'a>(
        ::std::option::Option<&'a unique var i32>,
        i32,
    ) -> ::std::option::Option<&'a unique var i32>;
}

extern "C++" {
    safe fn run_with_opaque_ref() -> i32;
    safe fn run_rust_cpp_refs() -> i32;
    safe fn run_callback() -> i32;
    safe fn run_rust_nullable_refs() -> i32;

    impl c++::MyCppWrapper {
        safe fn new(i32, i32) -> c++::MyCppWrapper;
        safe fn print(&self);
    }

    impl c++::MyConservativeWrapper {
        safe fn new(i64, i32) -> c++::MyConservativeWrapper;
        safe fn print(&self);
    }

    impl c++::BoxedInt {
        safe fn new(i32) -> c++::BoxedInt;
        safe fn get(&self) -> i32;
    }

    impl c++::OpaqueRef {
        safe fn read(&self) -> i32;
    }

    // References to C++ objects are Rust references in Rust and C++ references in C++ (`const
    // CppType&`, `int32_t&`), so functions taking and returning them can be safe.
    safe fn sum_into<'a>(&'a const c++::MyCppWrapper, &'a unique var i32);
    safe fn larger_x<'a>(&'a const c++::MyCppWrapper, &'a const c++::MyCppWrapper) -> &'a const c++::MyCppWrapper;
    safe fn non_negative_x<'a>(
        ::std::option::Option<&'a const c++::MyCppWrapper>,
    ) -> ::std::option::Option<&'a const c++::MyCppWrapper>;
    // C++-style pointers and references are raw pointers in Rust (`*mut T` for `T*`), which may be
    // null or invalid, and plain pointers in C++.
    unsafe fn swap_xy(c++::MyCppWrapper*);
    unsafe fn invert_bool(bool*);
    // Lifetime-less C++ references (`const T&`, `T&`) are raw pointers in Rust and C++ references
    // in C++.
    unsafe fn pick_larger_cpp_ref(const c++::MyCppWrapper&, i32&) -> const c++::MyCppWrapper&;
    // Rust-value references to C++ pointers (`&'a T*`, `&'a mut T*`).
    unsafe fn copy_i32_ptr<'a>(&'a i32*, &'a mut i32*) -> &'a i32*;
    safe fn run_rust_struct_and_trait() -> i32;
    unsafe fn reset_wrapper_ptr(c++::MyCppWrapper**, c++::MyCppWrapper*);
    unsafe fn read_through_ptr_to_const_ptr(i32* const*, const i32**);
}
