import "receiver.zng";
import "../aggregation/aggregation.zng";

#cpp_additional_includes "
#include <run_config.h>
"

type c++::cpp_processor::RunConfig {
    field &const packets (type = u32);
}

// The home of `std::unique_ptr` is aggregation.zng, which gives this instantiation its layout and
// `get()`. This module can declare it because it declares `RunConfig` (like Rust's orphan rule).
type c++::std::unique_ptr<c++::cpp_processor::RunConfig> {}

type crate::Processor {
    #layout(size = 0, align = 1);
    fn new() -> crate::Processor;
    fn run(
        &self,
        &mut receiver::Receiver,
        &unique var c++::cpp_stats::StatsAccumulator,
        &const c++::std::unique_ptr<c++::cpp_processor::RunConfig>,
    );
}

// This isn't necessary for the example but we want to test that specialization
// of the same type across modules works properly (See receiver.zng)
type ::std::option::Option<crate::Processor> {
    #layout(size = 1, align = 1);

    variant None {}
    variant Some {
        field 0 (offset = auto, type = crate::Processor);
    }
    fn unwrap(self) -> crate::Processor;
}
