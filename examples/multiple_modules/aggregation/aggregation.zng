    #layout(size = 16, align = 8);
    #cpp_heap_allocated;
}

extern "C++" {
    impl c++::cpp_stats::StatsAccumulator {
        safe fn create() -> c++::cpp_stats::StatsAccumulator;
        safe fn add_packet(&mut self, packet::Packet);
        safe fn print_report(&self);
    }
}
